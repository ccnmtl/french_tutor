.env
.env.local
.env.*.local
*.key
*.pem
secrets/
config/secrets.json

# ─── OS / editor ────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.*.sublime-*

